# Scott Studio — Docker Compose 環境變數範本
#
# 使用方式：
#   cp deploy/compose/.env.example deploy/compose/.env
#   然後填入真實值。
#
# ⚠️  .env 已被 .gitignore 排除，切勿提交。
# ⚠️  所有金鑰只放在此檔或部署平台的 secret 管理，不得寫入程式碼。

## ── PostgreSQL ───────────────────────────────────────────────────────────────
POSTGRES_DB=scott_studio
POSTGRES_USER=scott
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

## ── Redis ────────────────────────────────────────────────────────────────────
REDIS_PORT=6379

## ── MinIO（S3 相容物件儲存）──────────────────────────────────────────────────
MINIO_ROOT_USER=scottstudio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
STUDIO_S3_BUCKET_NAME=scott-studio-assets

## ── 後端 ─────────────────────────────────────────────────────────────────────
STUDIO_BACKEND_PORT=8000
STUDIO_DEBUG=false
# 前端來源，逗號分隔
STUDIO_CORS_ORIGINS=http://localhost:7788,http://127.0.0.1:7788

## ── 前端 ─────────────────────────────────────────────────────────────────────
STUDIO_FRONTEND_PORT=7788
# 瀏覽器實際存取後端的位址（跨埠部署時需為宿主機位址）
STUDIO_API_BASE_URL=http://localhost:8000

## ── 既有 Scott 股市分析 app ──────────────────────────────────────────────────
# 留空表示不需登入碼
ACCESS_CODE=
SECRET_KEY=change-me-flask-secret

## ── Studio 任務執行 ──────────────────────────────────────────────────────────
# celery：送往 worker（compose 預設）；inline：背景執行緒，單機可用
STUDIO_TASK_EXECUTION_MODE=celery

## ── AI 供應商金鑰 ─────────────────────────────────────────────────────────────
# Provider 資料表只存「環境變數名稱」，實際金鑰只在這裡。
# 未設定的供應商會在 Provider 管理頁顯示為「金鑰未就緒」。
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
# OpenAI 相容 / 圖片 / 影片供應商可自行新增，例如：
# MY_IMAGE_PROVIDER_API_KEY=
# MY_VIDEO_PROVIDER_API_KEY=
