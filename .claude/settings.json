{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "claude-code-operator",
  "permissions": {
    "deny": [
      "Bash(git push)",
      "Bash(git push *)",
      "Bash(git push:*)",
      "Bash(gh pr create:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh release create:*)",
      "Bash(gh repo delete:*)",
      "Bash(railway up:*)",
      "Bash(railway redeploy:*)",
      "Bash(railway run:*)",
      "Bash(npm publish:*)",
      "Bash(twine upload:*)",
      "Bash(dropdb:*)"
    ],
    "ask": [
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(sqlite3:*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$CLAUDE_PROJECT_DIR/.claude/hooks/block-remote-writes.py\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
