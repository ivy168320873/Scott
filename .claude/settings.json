{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "agent": "claude-code-operator",
  "permissions": {
    "ask": [
      "Bash(git push:*)",
      "Bash(git merge:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(railway up:*)",
      "Bash(railway run:*)",
      "Bash(railway redeploy:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(dropdb:*)",
      "Bash(sqlite3:*)"
    ]
  }
}
