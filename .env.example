# Required in production
ACCESS_CODE=replace-with-a-long-random-passphrase
SECRET_KEY=replace-with-at-least-32-random-bytes

# Market / AI providers
ANTHROPIC_API_KEY=
ALPHA_VANTAGE_KEY=
FINNHUB_KEY=
FRED_API_KEY=
# SEC requires a descriptive app/contact User-Agent, e.g.
# ScottMarketIntelligence/2.0 your-email@example.com
SEC_USER_AGENT=

# Institutional quote provenance. IEX is single-exchange; SIP requires the
# corresponding Alpaca market-data entitlement.
ALPACA_API_KEY=
ALPACA_SECRET_KEY=
ALPACA_DATA_FEED=iex

# Optional representative breadth universes (comma-separated overrides)
# US_BREADTH_SYMBOLS=RSP,IWM,MDY,XLK,XLF,XLI,XLY,XLP,XLE,XLV,XLU,SMH
# TW_BREADTH_SYMBOLS=2330.TW,2317.TW,2454.TW,2308.TW,2382.TW,2881.TW

# Market intelligence worker
MARKET_INTELLIGENCE_ENABLE=false
# 掛載 Volume 時會自動開啟；可明確設 true/false 覆寫。
RAILWAY_INTELLIGENCE_WORKER_ENABLE=
MARKET_INTELLIGENCE_TIMEZONE=Asia/Taipei
MARKET_INTELLIGENCE_POLL_MINUTES=30
MARKET_INTELLIGENCE_DAILY_TIME=08:30
MARKET_INTELLIGENCE_LOOKBACK_HOURS=30
MARKET_INTELLIGENCE_MAX_SYMBOLS=20
MARKET_INTELLIGENCE_MAX_ARTICLES=60
MARKET_INTELLIGENCE_BREAKING_IMPORTANCE=82
MARKET_INTELLIGENCE_EMAIL=true
MARKET_INTELLIGENCE_LINE=true
MARKET_INTELLIGENCE_MODEL=claude-haiku-4-5-20251001

# Demo data is opt-in and should remain false for real analysis
ALLOW_DEMO_DATA=false

# Personal risk brain default. The saved in-app profile takes precedence.
DEFAULT_RISK_PRESET=balanced

# Railway Volume. Railway supplies RAILWAY_VOLUME_MOUNT_PATH after a Volume is mounted.
# USER_DATA_DB=/data/user_data.db

# Background jobs: enable on exactly one Railway service only
SCHEDULER_ENABLE=false
BACKGROUND_WORKERS_ENABLE=false

# LINE Messaging API (server-side only)
LINE_CHANNEL_ACCESS_TOKEN=
LINE_USER_ID=

# Email alerts
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Alpaca defaults to paper. Live mode requires both settings and per-order confirmation.
ALPACA_PAPER=true
# ENABLE_LIVE_TRADING=I_UNDERSTAND_LIVE_TRADING_RISK
