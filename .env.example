# 複製本檔為 `.env` 後填入實際值。`.env` 已被 git 忽略，切勿提交。
# 所有金鑰一律只放在 .env 或部署平台（Railway）的環境變數，不得寫入程式碼。

# ---- Flask ----
# 正式環境務必改成隨機長字串
SECRET_KEY=
# 網站存取密碼
ACCESS_CODE=
PORT=5000
# FLASK_ENV=development

# ---- AI Agent ----
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
# CLI_AGENT_MODEL=claude-opus-4-8
# CLI_AGENT_EFFORT=high

# ---- 行情資料來源（選用；未設定時對應功能會降級）----
FINNHUB_KEY=
ALPHA_VANTAGE_KEY=

# ---- 交易（Alpaca）----
# 預設使用 paper trading，正式下單前務必確認
ALPACA_PAPER=true
ALPACA_API_KEY=
ALPACA_SECRET_KEY=

# ---- 排程 ----
# 設為 1 才會啟用背景排程
SCHEDULER_ENABLE=0

# ---- 告警：Email ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# ---- 告警：LINE ----
LINE_NOTIFY_TOKEN=

# ---- 資料儲存 ----
USER_DATA_DB=user_data.db
USER_DATA_FILE=user_data.json
