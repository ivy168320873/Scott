# ============================================================================
# Polymarket Paper Trading Bot — environment configuration
# Copy this file to `.env` and fill in the values.
# ============================================================================

# --- Safety switch -----------------------------------------------------------
# Hard kill-switch for any real order placement. In v1 this MUST stay false.
# The codebase has no live-order code path, but this flag is asserted on boot.
LIVE_TRADING_ENABLED=false

# --- Database ----------------------------------------------------------------
# Standard PostgreSQL DSN used by asyncpg.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/polymarket_bot

# --- Polymarket CLOB ---------------------------------------------------------
CLOB_REST_URL=https://clob.polymarket.com
CLOB_WS_URL=wss://ws-subscribe-clob.polymarket.com/ws/market
GAMMA_API_URL=https://gamma-api.polymarket.com
# Comma-separated condition_id / market slugs to track. Leave blank to
# auto-discover the most liquid active markets via the Gamma API.
TRACKED_MARKETS=
# How many active markets to auto-track when TRACKED_MARKETS is empty.
AUTO_TRACK_TOP_N=10

# --- News ingestion ----------------------------------------------------------
# Comma-separated RSS feed URLs.
NEWS_RSS_FEEDS=https://feeds.reuters.com/reuters/topNews,http://rss.cnn.com/rss/cnn_topstories.rss,https://feeds.bbci.co.uk/news/rss.xml
NEWS_POLL_SECONDS=30

# --- LLM classifier ----------------------------------------------------------
# Provider: "anthropic", "openai", or "stub" (deterministic offline fallback).
LLM_PROVIDER=stub
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# --- Fair-value engine -------------------------------------------------------
# fair_price = mid + ALPHA * news_score * exp(-LAMBDA * seconds_since_news)
FAIR_ALPHA=0.15
FAIR_LAMBDA=0.02

# --- Signal engine -----------------------------------------------------------
MINIMUM_EDGE=0.03
CONFIDENCE_THRESHOLD=0.6

# --- Paper trading -----------------------------------------------------------
PAPER_STARTING_CASH=10000
PAPER_SLIPPAGE_BPS=20
PAPER_FEE_BPS=0
PAPER_ORDER_SIZE_USD=100

# --- Risk manager ------------------------------------------------------------
MAX_RISK_PER_TRADE_USD=100
MAX_MARKET_EXPOSURE_USD=400
MAX_DAILY_LOSS_USD=500
MAX_HOLDING_SECONDS=90

# --- Server ------------------------------------------------------------------
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
